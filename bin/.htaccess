# Bloqueia qualquer acesso direto a esta pasta e subpastas.
# Camada de proteção extra, para o caso da Raiz do documento do site
# ainda não estar apontando para /public (que é o correto).
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
